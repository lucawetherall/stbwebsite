---
import EventRow from './EventRow.astro';
import ServiceTimes from './ServiceTimes.astro';
import WhatsOnCalendar from './WhatsOnCalendar.astro';
import {
  describeWhen,
  formatCivilDate,
  formatCivilRange,
  groupByMonth,
  todayInLondon,
  type SiteEvent,
} from '../lib/events';
import { getCalendarEvents } from '../lib/events-source';
import { site } from '../data/site';

interface Props {
  events: SiteEvent[];
}
const { events } = Astro.props;

// One highlighted event at most — the soonest the parish has asked us to lift up.
const featured = events.find((e) => e.featured);

// The list shows *everything* the calendar knows — every occurrence, regular worship included —
// so the two views never disagree about what is on. It reaches as far as the calendar's month
// navigation (twelve months ahead); "-31" is a safe inclusive bound on a civil-date string.
const today = todayInLondon();
const [ty, tm] = today.split('-').map(Number);
const horizon = `${ty + 1}-${String(tm).padStart(2, '0')}-31`;
const list = (await getCalendarEvents())
  .filter((e) => (e.endDate ?? e.date) >= today && e.date <= horizon)
  // Each occurrence sits under its own date, so the series phrase would just repeat down the page.
  .map((e) => ({ ...e, recurrenceText: undefined }));
const months = groupByMonth(list);

const calendarUrl = new URL('/calendar.ics', site.url);
const subscribeUrl = `webcal://${calendarUrl.host}${calendarUrl.pathname}`;

// The panel shows the date on its own line, so the meta line must not repeat a multi-day range.
const featuredDate = featured
  ? featured.endDate
    ? formatCivilRange(featured.date, featured.endDate)
    : formatCivilDate(featured.date, { weekday: true })
  : '';
const featuredWhen = featured ? describeWhen(featured, { includeDate: false }) : '';
---
{featured && (
  <section
    class:list={['whats-on-featured', !featured.image && 'is-textonly']}
    aria-labelledby="featured-heading"
  >
    {featured.image && (
      <img
        class="whats-on-featured__img"
        src={featured.image}
        alt={featured.imageAlt ?? ''}
        loading="eager"
        decoding="async"
      />
    )}
    <div class="whats-on-featured__body">
      <p class="label" id="featured-heading">Coming up</p>
      <h2 class="whats-on-featured__title">{featured.title}</h2>
      <p class="whats-on-featured__when">
        {featuredDate}{featuredWhen && <span> · {featuredWhen}</span>}
      </p>
      {featured.recurrenceText && (
        <p class="whats-on-featured__repeat">{featured.recurrenceText}</p>
      )}
      {featured.description && (
        <p class="whats-on-featured__desc">{featured.description}</p>
      )}
      {featured.url && (
        <p class="whats-on-featured__action">
          <a class="btn" href={featured.url}>{featured.urlLabel ?? 'More details'}</a>
        </p>
      )}
    </div>
  </section>
)}

{/* Calendar <-> List. Revealed and wired by the calendar's script; without JavaScript the
    list below simply stands alone, which is the page working as designed. The visible
    label is decorative — each section carries its own heading for assistive tech. */}
<div class="wo-head">
  <p class="label wo-head__label" aria-hidden="true">The diary</p>
  <div class="wo-views" data-wo-toggle hidden role="group" aria-label="How to show the diary">
    <button type="button" class="wo-views__btn is-active" data-wo-view="calendar" aria-pressed="true">
      Calendar
    </button>
    <button type="button" class="wo-views__btn" data-wo-view="diary" aria-pressed="false">
      List
    </button>
  </div>
</div>

<section class="whats-on-diary" data-wo-diary aria-labelledby="diary-heading">
  <h2 class="sr-only" id="diary-heading">The diary</h2>

  {months.length > 0 ? (
    months.map((month) => (
      <section class="whats-on-month">
        <h3 class="label whats-on-month__title">{month.label}</h3>
        <ul class="events-list">
          {month.events.map((event) => <EventRow event={event} />)}
        </ul>
      </section>
    ))
  ) : (
    <p class="whats-on-empty">
      There is nothing in the diary just now. Our
      <a href="/worship">regular pattern of worship</a> continues week by week, and special
      services are announced in the <a href="/news">Weekly News</a>.
    </p>
  )}
</section>

<WhatsOnCalendar />

<section class="whats-on-regular" aria-labelledby="regular-heading">
  <h2 class="label whats-on-regular__title" id="regular-heading">Week by week</h2>
  <ServiceTimes />
</section>

<p class="page-aside">
  You can <a href={subscribeUrl}>subscribe to our calendar</a> in Apple Calendar, Google Calendar
  or Outlook, or <a href="/calendar.ics">download the calendar file</a>. Everything here is also
  announced in our <a href="/news">Weekly News</a>.
</p>

<style>
  /* ---- section head: label + view toggle ---- */
  .wo-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* Collapses with the featured panel's bottom margin when one is shown. */
    margin-top: 3rem;
    margin-bottom: 1.8rem;
  }
  .wo-head__label { color: var(--violet); }
  .wo-views { display: flex; }
  .wo-views__btn {
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: .68rem;
    font-weight: 600;
    padding: .55rem 1.3rem;
    background: none;
    border: 1px solid var(--line);
    color: var(--ink);
    cursor: pointer;
    transition: background .2s, color .2s, border-color .2s;
  }
  .wo-views__btn:first-child { border-radius: 3px 0 0 3px; }
  .wo-views__btn:last-child { border-radius: 0 3px 3px 0; border-left: none; }
  .wo-views__btn:hover { color: var(--violet-deep); }
  .wo-views__btn.is-active {
    background: var(--violet);
    border-color: var(--violet);
    color: var(--white);
  }
  .wo-views__btn.is-active:hover { color: var(--white); }

  /* ---- featured ---- */
  .whats-on-featured {
    display: grid;
    grid-template-columns: minmax(0, 42%) 1fr;
    gap: 2rem;
    align-items: center;
    padding: 1.8rem;
    margin-bottom: 3rem;
    background: var(--paper-2);
    border-radius: 5px;
  }
  /* A text-only highlight still needs to read as a panel, not a stray paragraph. */
  .whats-on-featured.is-textonly { grid-template-columns: 1fr; }
  .whats-on-featured__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
  }
  .whats-on-featured__body { min-width: 0; }
  .whats-on-featured__title {
    margin-top: .8rem;
    font-size: clamp(1.35rem, 2.55vw, 1.85rem);
    line-height: 1.1;
  }
  .whats-on-featured__when {
    margin-top: .7rem;
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: .68rem;
    font-weight: 600;
    color: var(--violet);
  }
  .whats-on-featured__repeat { margin-top: .3rem; color: var(--ink-soft); }
  .whats-on-featured__desc { margin-top: .8rem; color: var(--ink-soft); }
  .whats-on-featured__action { margin-top: 1.4rem; }

  /* ---- diary ---- */
  .whats-on-month { margin-bottom: 2.6rem; }
  .whats-on-month:last-child { margin-bottom: 0; }
  .whats-on-month__title { display: block; margin-bottom: 1rem; }
  .events-list { list-style: none; }

  .whats-on-empty { color: var(--ink-soft); max-width: 62ch; }
  .whats-on-empty a {
    text-decoration: none;
    border-bottom: 1px solid var(--violet);
    transition: color .2s, border-color .2s;
  }
  .whats-on-empty a:hover { color: var(--violet-deep); border-color: var(--violet-deep); }

  /* ---- regular pattern ---- */
  .whats-on-regular { margin-top: 3.4rem; padding-top: 2.4rem; border-top: 1px solid var(--line); }
  .whats-on-regular__title { display: block; margin-bottom: 1.4rem; }

  @media (max-width: 700px) {
    .whats-on-featured { grid-template-columns: 1fr; gap: 1.2rem; padding: 1.4rem; }
  }
</style>
