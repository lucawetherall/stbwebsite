---
import { imageSibling, imageSrcset } from '../lib/images';

interface Props {
  kicker?: string;
  title: string;
  body: string;
  link?: { label: string; href: string };
  image?: string;
  /** Screen-reader description of the artwork — pass one whenever `image` is overridden. */
  imageAlt?: string;
}
const {
  kicker = 'Music',
  title,
  body,
  link = { label: 'The music of St Barnabas', href: '/music' },
  image = '/images/hero/altar.webp',
  imageAlt = 'The high altar and sanctuary of St Barnabas during the liturgy.',
} = Astro.props;
---
<section class="music-band">
  {/* A real <img>, not a CSS background: the band sits below the fold, and an <img> can
      lazy-load — a background image downloads during first paint and competes with the
      hero, fonts and CSS for bandwidth. The scrim (::before) sits between image and text. */}
  <img
    class="music-band__bg"
    src={imageSibling(image, 1280) ?? image}
    srcset={imageSrcset(image)}
    sizes={imageSrcset(image) ? '100vw' : undefined}
    alt={imageAlt}
    loading="lazy"
    decoding="async"
  />
  <div class="wrap music-band__inner">
    <p class="music-band__kicker">{kicker}</p>
    <h2 class="music-band__title">{title}</h2>
    <p class="music-band__body">{body}</p>
    {link && <a class="music-band__link" href={link.href}>{link.label}</a>}
  </div>
</section>

<style>
  .music-band {
    position: relative;
    color: var(--white);
    isolation: isolate;
  }
  .music-band__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    z-index: -2;
  }
  /* flat scrim — NOT a gradient */
  .music-band::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim);
    z-index: -1;
  }
  .music-band__inner {
    padding-block: clamp(4rem, 12vh, 7rem);
    max-width: 760px;
  }
  .music-band__kicker {
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .2em;
    font-size: .72rem;
    font-weight: 600;
    margin-bottom: 1.1rem;
  }
  .music-band__title {
    font-size: clamp(1.6rem, 3.7vw, 2.55rem);
    line-height: 1.05;
    max-width: 16ch;
  }
  .music-band__body {
    margin-top: 1.3rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    line-height: 1.4;
    max-width: 52ch;
    color: var(--white-soft);
  }
  .music-band__link {
    display: inline-block;
    margin-top: 1.8rem;
    text-decoration: none;
    color: var(--white);
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: .72rem;
    padding-bottom: .3rem;
    border-bottom: 1px solid var(--white);
    transition: opacity .2s;
  }
  .music-band__link:hover { opacity: .72; }
  /* The global violet ring vanishes against the scrim-darkened photograph. */
  .music-band__link:focus-visible { outline: 2px solid var(--white); outline-offset: 4px; }
</style>
