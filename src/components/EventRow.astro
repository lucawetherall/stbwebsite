---
import { describeWhen, formatCivilDate, weekdayOf, type SiteEvent } from '../lib/events';

interface Props {
  event: SiteEvent;
  /** Show the weekday above the numeral. Off inside a tight strip. */
  showWeekday?: boolean;
}
const { event, showWeekday = true } = Astro.props;

const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

const MONTHS_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const [, startMonth, startDay] = event.date.split('-').map(Number);
const [, endMonth, endDay] = (event.endDate ?? event.date).split('-').map(Number);
// The month heading above already names the month, so a same-month span needs only the
// numerals; a span into the next month names it ("30–2 Oct") so "30–2" never appears.
const numeral =
  event.endDate && event.endDate !== event.date
    ? startMonth === endMonth
      ? `${startDay}–${endDay}`
      : `${startDay}–${endDay} ${MONTHS_SHORT[endMonth - 1]}`
    : String(startDay);
const weekday = WEEKDAYS[weekdayOf(event.date)];
const when = describeWhen(event);
// Screen readers get the full date spelled out; the visible cell is just the numeral.
const fullDate = event.endDate
  ? `${formatCivilDate(event.date, { weekday: true, year: false })} to ${formatCivilDate(event.endDate, { weekday: true })}`
  : formatCivilDate(event.date, { weekday: true });
---
<li class="event-row">
  <time class="event-row__date" datetime={event.date}>
    {showWeekday && <span class="event-row__weekday">{weekday}</span>}
    <span class="event-row__day serif">{numeral}</span>
    <span class="sr-only">{fullDate}</span>
  </time>

  {/* The title itself is the link, as on the news listing — no "More details" line per row. */}
  <div class="event-row__body">
    <h3 class="event-row__title">
      {event.url ? (
        <a class="event-row__titlelink" href={event.url}>{event.title}</a>
      ) : (
        event.title
      )}
    </h3>
    {when && <p class="event-row__meta">{when}</p>}
    {event.recurrenceText && <p class="event-row__repeat">{event.recurrenceText}</p>}
    {event.description && <p class="event-row__desc">{event.description}</p>}
    {/* Only an editor's explicit call to action ("Book tickets") earns its own line. */}
    {event.url && event.urlLabel && (
      <p class="event-row__action">
        <a class="txt-link" href={event.url}>{event.urlLabel}</a>
      </p>
    )}
  </div>

  {event.image && (
    <img
      class="event-row__thumb"
      src={event.image}
      alt={event.imageAlt ?? ''}
      loading="lazy"
      decoding="async"
      width="128"
      height="80"
    />
  )}
</li>

<style>
  .event-row {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    gap: 1.5rem;
    border-top: 1px solid var(--line);
    padding-block: 1.4rem;
  }
  .event-row:last-child { border-bottom: 1px solid var(--line); }

  .event-row__date { display: block; padding-top: .2rem; }
  .event-row__weekday {
    display: block;
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: .66rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .event-row__day {
    display: block;
    margin-top: .1rem;
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--burgundy);
  }

  .event-row__title { font-size: clamp(1.05rem, 1.9vw, 1.3rem); }
  .event-row__titlelink {
    color: inherit;
    text-decoration: none;
    transition: color .2s;
  }
  .event-row__titlelink:hover {
    color: var(--burgundy-deep);
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .event-row__meta,
  .event-row__repeat {
    margin-top: .35rem;
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: .66rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .event-row__repeat { text-transform: none; letter-spacing: 0; font-size: .9rem; font-weight: 400; }
  .event-row__desc { margin-top: .55rem; color: var(--ink-soft); max-width: 62ch; }
  .event-row__action { margin-top: .7rem; }

  .event-row__thumb {
    width: 128px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
    align-self: center;
  }

  @media (max-width: 560px) {
    .event-row { grid-template-columns: 1fr; gap: .5rem; }
    .event-row__date { display: flex; align-items: baseline; gap: .6rem; padding-top: 0; }
    .event-row__day { margin-top: 0; font-size: 1.3rem; }
    .event-row__thumb { width: 100%; height: auto; aspect-ratio: 16 / 9; margin-top: .5rem; }
  }
</style>
