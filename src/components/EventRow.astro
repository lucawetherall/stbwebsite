---
import { describeWhen, formatCivilDate, weekdayOf, type SiteEvent } from '../lib/events';

interface Props {
  event: SiteEvent;
  /** Show the weekday above the numeral. Off inside a tight strip. */
  showWeekday?: boolean;
}
const { event, showWeekday = true } = Astro.props;

const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

const day = Number(event.date.split('-')[2]);
const lastDay = event.endDate ? Number(event.endDate.split('-')[2]) : undefined;
// The month heading above already names the month, so the row need only carry the numeral.
const numeral = lastDay && lastDay !== day ? `${day}–${lastDay}` : String(day);
const weekday = WEEKDAYS[weekdayOf(event.date)];
const when = describeWhen(event);
// Screen readers get the full date spelled out; the visible cell is just the numeral.
const fullDate = event.endDate
  ? `${formatCivilDate(event.date, { weekday: true, year: false })} to ${formatCivilDate(event.endDate, { weekday: true })}`
  : formatCivilDate(event.date, { weekday: true });
---
<li class="event-row">
  <time class="event-row__date" datetime={event.date}>
    {showWeekday && <span class="event-row__weekday">{weekday}</span>}
    <span class="event-row__day serif">{numeral}</span>
    <span class="sr-only">{fullDate}</span>
  </time>

  <div class="event-row__body">
    <h3 class="event-row__title">{event.title}</h3>
    {when && <p class="event-row__meta">{when}</p>}
    {event.recurrenceText && <p class="event-row__repeat">{event.recurrenceText}</p>}
    {event.description && <p class="event-row__desc">{event.description}</p>}
    <p class="event-row__foot">
      <span class="event-row__cat">{event.category}</span>
      {event.url && (
        <a class="txt-link event-row__link" href={event.url}>{event.urlLabel ?? 'More details'}</a>
      )}
    </p>
  </div>

  {event.image && (
    <img
      class="event-row__thumb"
      src={event.image}
      alt={event.imageAlt ?? ''}
      loading="lazy"
      decoding="async"
      width="128"
      height="80"
    />
  )}
</li>

<style>
  .event-row {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    gap: 1.5rem;
    border-top: 1px solid var(--line);
    padding-block: 1.4rem;
  }
  .event-row:last-child { border-bottom: 1px solid var(--line); }

  .event-row__date { display: block; padding-top: .2rem; }
  .event-row__weekday {
    display: block;
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: .66rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .event-row__day {
    display: block;
    margin-top: .1rem;
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--burgundy);
  }

  .event-row__title { font-size: clamp(1.05rem, 1.9vw, 1.3rem); }
  .event-row__meta,
  .event-row__repeat {
    margin-top: .35rem;
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: .66rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .event-row__repeat { text-transform: none; letter-spacing: 0; font-size: .9rem; font-weight: 400; }
  .event-row__desc { margin-top: .55rem; color: var(--ink-soft); }
  .event-row__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .5rem 1.4rem;
    margin-top: .7rem;
  }
  .event-row__cat {
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .64rem;
    font-weight: 600;
    color: var(--burgundy);
  }

  .event-row__thumb {
    width: 128px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
    align-self: center;
  }

  @media (max-width: 560px) {
    .event-row { grid-template-columns: 1fr; gap: .5rem; }
    .event-row__date { display: flex; align-items: baseline; gap: .6rem; padding-top: 0; }
    .event-row__day { margin-top: 0; font-size: 1.3rem; }
    .event-row__thumb { width: 100%; height: auto; aspect-ratio: 16 / 9; margin-top: .5rem; }
  }
</style>
