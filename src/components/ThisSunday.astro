---
import { getCollection } from 'astro:content';
import ServiceSheet from './ServiceSheet.astro';
import { currentSheet } from '../lib/services';

const sheets = (await getCollection('services')).map((e) => e.data);
const sheet = currentSheet(sheets, new Date());

// The eyebrow adapts to what we are actually showing:
//  - a sheet dated on a Sunday → "This Sunday"
//  - a sheet on any other day  → "Next service" (e.g. a weekday feast in Holy Week)
// With no sheet the component renders nothing at all: the standing pattern is the
// ServiceTimesBand immediately above, and repeating it here would only say the same
// thing twice, less well. See src/lib/services.ts for when that happens.
const eyebrow = sheet?.date.getUTCDay() === 0 ? 'This Sunday' : 'Next service';
---
{sheet && (
  <section class="this-sunday section" aria-labelledby="this-sunday-heading">
    <div class="wrap">
      <p class="label">{eyebrow}</p>

      <ServiceSheet sheet={sheet} level={2} showDate headingId="this-sunday-heading" />

      <p class="this-sunday__more">
        <a class="txt-link" href="/music">The full music list</a>
      </p>
    </div>
  </section>
)}

<style>
  /* The hairline separates this from the ServiceTimesBand above, which shares the same
     ground. It lives here rather than on the band so it vanishes with the component on the
     weeks when there is no sheet — no conditional needed. */
  .this-sunday { background: var(--paper); border-top: 1px solid var(--line); }
  .this-sunday .label { margin-bottom: 1.1rem; }
  .this-sunday__more { display: flex; flex-wrap: wrap; gap: 1.2rem 2rem; margin-top: 2.6rem; }
</style>
