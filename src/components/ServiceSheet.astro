---
/**
 * One Sunday's music: the feast, then each service and what is sung at it.
 *
 * Shared by the homepage "This Sunday" band and the forward list on /music/music-list, so the
 * two can never drift apart typographically. The caller decides the heading level and whether
 * the date belongs here (the homepage) or in a column of its own (the list).
 */
import { fmt, type SheetLike } from '../lib/services';

interface Props {
  sheet: SheetLike;
  /** Heading level for the feast; services sit one level below it. */
  level?: 2 | 3;
  /** Print the date under the feast — the homepage does, the list has its own date column. */
  showDate?: boolean;
  /** Optional id for the feast heading, so a section can be labelled by it. */
  headingId?: string;
}
const { sheet, level = 2, showDate = false, headingId } = Astro.props;

const Feast = `h${level}` as 'h2' | 'h3';
const Service = `h${level + 1}` as 'h3' | 'h4';

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---
<Feast class="sheet__feast" id={headingId}>{sheet.feast}</Feast>
{showDate && (
  <p class="sheet__date"><em>{fmtDate(sheet.date)}</em></p>
)}

{sheet.offices.map((office) => (
  <div class="office">
    <Service class="office__heading">{`${office.time} · ${office.name}`}</Service>
    <dl class="office__items">
      {office.items.map((item) => (
        <div class="office__row">
          <dt class="office__label">{item.label}</dt>
          <dd class="office__values">
            {item.values.map((value) => {
              const { lead, title, tail } = fmt(item.label, value);
              return (
                <span class="office__value">{lead}{title && <em>{title}</em>}{tail}</span>
              );
            })}
          </dd>
        </div>
      ))}
    </dl>
  </div>
))}

<style>
  .sheet__feast { font-size: clamp(1.65rem, 3.2vw, 2.4rem); }
  .sheet__date {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink-soft);
    margin-top: .4rem;
  }

  .office { margin-top: 2.4rem; }
  .office__heading {
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .16em;
    font-size: .74rem;
    font-weight: 600;
    color: var(--burgundy);
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    margin-bottom: 1rem;
  }
  .office__items { display: grid; gap: .55rem; }
  .office__row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .office__label {
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .68rem;
    font-weight: 600;
    color: var(--burgundy);
    padding-top: .15rem;
  }
  .office__values { display: flex; flex-direction: column; gap: .2rem; }
  .office__value { font-size: 1.06rem; }
  .office__value em { font-family: var(--font-display); font-style: italic; font-size: 1.16rem; }

  @media (max-width: 560px) {
    .office__row { grid-template-columns: 1fr; gap: .15rem; }
    .office__label { padding-top: .4rem; }
  }

  @media print {
    .office { break-inside: avoid; }
    .office__heading, .office__label { color: #000; }
  }
</style>
