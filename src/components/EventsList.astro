---
import EventRow from './EventRow.astro';
import type { SiteEvent } from '../lib/events';

interface Props {
  /** Already-loaded events — the page fetches once and passes them in. */
  events: SiteEvent[];
}
const { events } = Astro.props;
---
{events.length > 0 && (
  <ul class="events-list">
    {events.map((event) => <EventRow event={event} />)}
  </ul>
)}

<style>
  .events-list { list-style: none; }
</style>
