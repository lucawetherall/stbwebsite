---
import { serviceTimes, type ServiceTime } from '../data/serviceTimes';

interface Props {
  only?: 'sundays' | 'weekdays';
  /** Block-title heading level — 'h2' when the component sits directly under a page h1. */
  headingLevel?: 'h2' | 'h3';
  /**
   * The digest form: one line per service (time — name — day — note), no descriptions,
   * the two blocks side by side where they fit. Used at the top of What's On, where the
   * standing pattern must answer quickly and then hand over to the diary; the full
   * reference table stays on /worship/sundays and /worship/weekdays.
   */
  compact?: boolean;
}
const { only, headingLevel = 'h3', compact = false } = Astro.props;
const Heading = headingLevel;

const blocks: { title: string; items: ServiceTime[] }[] = [];
if (only !== 'weekdays') blocks.push({ title: 'Sundays', items: serviceTimes.sundays });
if (only !== 'sundays')
  blocks.push({ title: 'Weekdays · in the Lady Chapel', items: serviceTimes.weekdays });
---
<div class:list={['service-times', compact && 'service-times--compact']}>
  {blocks.map((block) => (
    <section class="service-block">
      <Heading class="service-block__title label">{block.title}</Heading>
      <dl class="service-list">
        {block.items.map((s) => (
          <div class:list={['service-row', compact && 'service-row--compact']}>
            <dt class:list={['service-row__time', compact && 'service-row__time--compact']}>{s.time}</dt>
            <dd class:list={['service-row__detail', compact && 'service-row__detail--compact']}>
              <span class="service-row__name">{s.name}</span>
              {s.when && <span class="service-row__when">{s.when}</span>}
              {s.note && <span class="service-row__note">{s.note}</span>}
              {!compact && s.description && <span class="service-row__desc">{s.description}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}
</div>

<style>
  .service-times { display: grid; gap: 2.8rem; }
  .service-block__title { color: var(--violet); margin-bottom: 1.2rem; }
  .service-list { display: grid; gap: 1.1rem; }
  .service-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 1.2rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }
  .service-row__time {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .service-row__detail { display: flex; flex-direction: column; gap: .25rem; }
  .service-row__name { font-size: 1.12rem; }
  .service-row__when {
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .68rem;
    font-weight: 600;
    color: var(--violet);
  }
  .service-row__note { color: var(--ink-soft); font-size: .98rem; }
  .service-row__desc { margin-top: .35rem; max-width: 56ch; }

  /* ---- compact (digest) form — the service-band's quiet row idiom ---- */
  .service-times--compact {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3.5rem;
    align-items: start;
  }
  .service-times--compact .service-list { gap: .55rem; }
  .service-row--compact {
    grid-template-columns: 5.2rem 1fr;
    gap: .9rem;
    padding-top: .55rem;
  }
  .service-row__time--compact {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .service-row__detail--compact {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .1rem .6rem;
  }
  .service-row__detail--compact .service-row__name { font-size: 1.05rem; }
  .service-row__detail--compact .service-row__note { font-size: .92rem; }

  @media (max-width: 720px) {
    .service-times--compact { grid-template-columns: 1fr; gap: 2.2rem; }
  }
  @media (max-width: 520px) {
    .service-row:not(.service-row--compact) { grid-template-columns: 1fr; gap: .3rem; }
  }
</style>
