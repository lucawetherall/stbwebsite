---
/**
 * The season card — an insert from the parish's printed music list, translated to the web.
 *
 * Two grounds, one structure: a tracked label, a Cormorant-italic standfirst, then each
 * service as a composed block in which the *name* leads (for a one-off feast the name is
 * the draw) and a mixed-case when-line follows. No Cormorant numerals at this size (the
 * compact caveat in ServiceTimesBand) and no tracked-caps dates — tracked uppercase is
 * reserved for the one label and the CTA.
 *
 * `variant="hero"`: an opaque ink panel that Hero.astro lays over the artwork's lower
 * edge — a printed insert, not a glass card. `--white` and `--ink-on-dark-muted` are
 * built for this ground, so AA holds by arithmetic whatever the artwork.
 * `variant="page"`: ink on paper-2, used on What's On and Special Services.
 *
 * The hero variant shows at most three services *from today* (the site rebuilds twice
 * daily, so a Holy Week card walks through the week rather than folding the Triduum into
 * an "…and more"); the page variant shows everything. Truncation is date-aware upstream —
 * services arrive already filtered to today-onwards.
 */
import type { SeasonFeature } from '../lib/seasons';

interface Props {
  feature: SeasonFeature;
  variant: 'hero' | 'page';
}
const { feature, variant } = Astro.props;

const services = variant === 'hero' ? feature.services.slice(0, 3) : feature.services;
const single = services.length === 1;
---
<aside class:list={['season-card', `season-card--${variant}`]} aria-label={feature.title}>
  <p class="label season-card__label">{feature.title}</p>
  <p class="season-card__standfirst serif">{feature.standfirst}</p>

  <ul class:list={['season-card__list', single && 'season-card__list--single']}>
    {services.map((s) => (
      <li class="season-card__service">
        <span class:list={['season-card__name', single && 'season-card__name--single']}>{s.name}</span>
        <span class="season-card__when">{s.when}</span>
      </li>
    ))}
  </ul>

  <p class="season-card__action">
    <a class="season-card__cta" href={feature.href}>
      {feature.ctaLabel}
    </a>
  </p>
</aside>

<style>
  .season-card {
    border-top: 2px solid var(--violet);
    padding: 1.6rem 1.8rem;
  }

  .season-card__standfirst {
    font-style: italic;
    font-size: 1.18rem;
    line-height: 1.35;
    margin-top: .7rem;
  }

  .season-card__list {
    list-style: none;
    margin: 1.3rem 0 0;
    padding: 0;
    display: grid;
    gap: .95rem;
  }
  .season-card__service { display: grid; gap: .15rem; }
  .season-card__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .season-card__name--single { font-size: 1.15rem; }
  .season-card__when {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: .95rem;
  }

  .season-card__action { margin-top: 1.4rem; }

  /* ---- hero: white on the ink panel ---- */
  .season-card--hero { background: var(--ink); color: var(--white); }
  .season-card--hero .season-card__label { color: var(--white); }
  .season-card--hero .season-card__when { color: var(--ink-on-dark-muted); }
  .season-card--hero .season-card__service + .season-card__service {
    border-top: 1px solid rgba(251, 249, 244, .18);
    padding-top: .95rem;
  }
  .season-card--hero .season-card__cta {
    display: inline-block;
    text-decoration: none;
    color: var(--white);
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: .72rem;
    padding-bottom: .3rem;
    border-bottom: 1px solid var(--white);
    transition: opacity .2s;
  }
  .season-card--hero .season-card__cta:hover { opacity: .72; }
  /* The global focus ring is violet — invisible on ink. */
  .season-card--hero .season-card__cta:focus-visible { outline: 2px solid var(--white); outline-offset: 4px; }

  /* ---- page: ink on paper-2 ---- */
  .season-card--page { background: var(--paper-2); }
  .season-card--page .season-card__label { color: var(--violet); }
  .season-card--page .season-card__when { color: var(--ink-soft); }
  .season-card--page .season-card__service + .season-card__service {
    border-top: 1px solid var(--line);
    padding-top: .95rem;
  }
  .season-card--page .season-card__cta {
    color: var(--ink);
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .7rem;
    font-weight: 600;
    text-decoration: none;
    padding-bottom: .3rem;
    border-bottom: 1px solid var(--violet);
    transition: color .2s, border-color .2s;
  }
  .season-card--page .season-card__cta:hover { color: var(--violet-deep); border-color: var(--violet-deep); }

  /* A parishioner prints the homepage in December and pins the services to the fridge. */
  @media print {
    .season-card { break-inside: avoid; border-top-color: #000; }
    .season-card--hero { background: none; color: #000; }
    .season-card--hero .season-card__label,
    .season-card--hero .season-card__when { color: #000; }
    .season-card__action { display: none; }
  }
</style>
