---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Consent from '../components/Consent.astro';
import { site } from '../data/site';
import { siteJsonLd } from '../lib/seo';
import { crumbsFor } from '../lib/breadcrumbs';

// Privacy-friendly analytics is emitted only when a domain is configured, so we
// never ship a broken/unowned analytics tag. (See DECISIONS.md.)
const plausibleDomain = process.env.PLAUSIBLE_DOMAIN;

interface Props {
  title: string;
  description?: string;
  /** OG/social image, absolute path under /images or full URL */
  image?: string;
  /** Open Graph type — 'article' for news posts */
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Label for the final breadcrumb when the page is not itself a nav entry (a post, a person) */
  breadcrumbTitle?: string;
  /** Hide the breadcrumb trail (the homepage, and pages that open on a hero) */
  hideBreadcrumbs?: boolean;
  /** Emit schema.org markup for the standing service times — worship pages and the homepage */
  serviceSchema?: boolean;
  /** Page-specific JSON-LD nodes, folded into the site graph rather than added as a second tag */
  jsonLd?: unknown[];
  /**
   * Relative weight in site search. Standing pages keep the default 1; the news archive is set
   * below it, so someone searching "evensong" is offered the Worship page before a 2018 notice
   * that happens to use the word more often.
   */
  searchWeight?: number;
}

const {
  title,
  description = 'An inclusive Christian community in the modern Catholic tradition of the Church of England, in Pitshanger, Ealing. Sung Mass on Sundays at 10.30am.',
  image = '/images/og-default.jpg',
  type = 'website',
  noindex = false,
  breadcrumbTitle,
  hideBreadcrumbs = false,
  serviceSchema = false,
  jsonLd = [],
  searchWeight,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const pageTitle = title === site.name ? title : `${title} · ${site.shortName}`;
const ogImage = image.startsWith('http') ? image : new URL(image, site.url).href;

// One `@graph` per page rather than a stack of standalone tags: the parish, the site, this
// page's breadcrumb trail and any page-specific nodes all reference each other by `@id`.
const crumbs = crumbsFor(Astro.url.pathname, { title: breadcrumbTitle ?? title });
const graph = siteJsonLd({ services: serviceSchema, crumbs, extra: jsonLd });

// The section a page belongs to, used to group and filter search results. Taken from the same
// trail as the breadcrumbs, so "Curious about Christianity?" files under About as the menu says.
const section = crumbs.length > 1 ? crumbs[1].label : 'Home';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#6A1B2D" />

    <!-- Preload primary font weights for first paint. Montserrat 700 sets every heading — the
         largest text on the page and the usual LCP element on interior pages; Source Serif 4 400
         sets the body. The nav's 600 and Cormorant's wordmark are deliberately not preloaded:
         both are small text in fixed-height rows, where font-display: swap costs nothing visible,
         and holding this list at two files keeps the critical path short. -->
    <link rel="preload" href="/fonts/montserrat-700-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / social -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* <-escape so an editor-authored "</script>" in any description can never close the tag early. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />

    {/* Read stored consent early so embeds can decide whether to load on first paint */}
    <script is:inline>
      try { window.__consent = JSON.parse(localStorage.getItem('stb-consent') || 'null') || {}; }
      catch (e) { window.__consent = {}; }
    </script>

    {plausibleDomain && (
      <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    {/* `data-pagefind-body` marks the region the search index is built from; a noindex page
        (the 404, /search itself) carries no such marker and so stays out of the index. */}
    <main id="main" data-pagefind-body={noindex ? undefined : true} data-pagefind-weight={searchWeight}>
      <span class="sr-only" data-pagefind-meta={`section:${section}`} data-pagefind-filter={`Section:${section}`}></span>
      {!hideBreadcrumbs && <Breadcrumbs crumbs={crumbs} />}
      <slot />
    </main>
    <SiteFooter />
    <Consent />
  </body>
</html>
