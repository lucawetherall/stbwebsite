---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import PostFooterNav from '../../components/PostFooterNav.astro';
import { CHURCH_ID, WEBSITE_ID, abs } from '../../lib/seo';
import { neighboursOf } from '../../lib/news';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  // Neighbours are worked out once here rather than per page, so the whole archive is walked
  // a single time no matter how many posts there are.
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, ...neighboursOf(posts, entry.id) },
  }));
}

const { entry, previous, next, related } = Astro.props;
const { Content } = await render(entry);
const { title, date, category, author, description, hero, heroAlt } = entry.data;
const fmtDate = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const metaDesc = description ?? `${category ?? 'News'} from St Barnabas Church, Ealing — ${title}.`;

const articleJsonLd = {
  '@type': 'BlogPosting',
  headline: title,
  description: metaDesc,
  datePublished: date.toISOString().slice(0, 10),
  ...(author && { author: { '@type': 'Person', name: author } }),
  ...(hero && { image: abs(hero) }),
  // The parish is described once in the site graph; reference it rather than restate it.
  publisher: { '@id': CHURCH_ID },
  isPartOf: { '@id': WEBSITE_ID },
  mainEntityOfPage: abs(Astro.url.pathname),
};
---
<Base
  title={title}
  description={metaDesc}
  image={hero}
  type="article"
  jsonLd={[articleJsonLd]}
  searchWeight={0.5}
>
  <article class="news-article">
    <header class="wrap news-article__head">
      <p class="label news-article__kicker">{category ?? 'News'}</p>
      <h1 class="news-article__title">{title}</h1>
      <p class="news-article__meta">
        <time datetime={date.toISOString().slice(0, 10)}>{fmtDate}</time>
        {author && <span> · {author}</span>}
      </p>
    </header>
    <div class="wrap page-body">
      {hero && (
        <img
          class="news-article__hero"
          src={hero}
          alt={heroAlt || title}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )}
      <Prose><Content /></Prose>
      <PostFooterNav previous={previous} next={next} related={related} />
    </div>
  </article>
</Base>

<style>
  .news-article__head { padding-top: clamp(2.6rem, 6vw, 4.5rem); padding-bottom: 1rem; }
  .news-article__kicker { margin-bottom: 1rem; }
  .news-article__title {
    font-size: clamp(1.75rem, 3.7vw, 2.7rem);
    line-height: 1.06;
    max-width: 24ch;
    text-wrap: balance;
  }
  .news-article__meta {
    margin-top: 1.2rem;
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .72rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .news-article__hero {
    width: 100%;
    /* Reserve the box before the image arrives (no CLS); the height cap still rules. */
    aspect-ratio: 2 / 1;
    max-height: 460px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 2rem;
  }
</style>
