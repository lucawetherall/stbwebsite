---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventsList from '../../components/EventsList.astro';
import { getDiaryEvents } from '../../lib/events-source';
import { eventsJsonLd } from '../../lib/events-jsonld';

// This page keeps the liturgical year; What's On carries everything else.
const upcoming = (await getDiaryEvents()).filter((e) => e.category === 'Worship');

const eventLd = eventsJsonLd(upcoming);
const groups = [
  {
    title: 'Lent, Holy Week & Easter',
    feasts: [
      'Ash Wednesday',
      'Palm Sunday',
      'Maundy Thursday',
      'Good Friday',
      'The Great Vigil & First Mass of Easter',
      'Easter Sunday',
    ],
  },
  {
    title: 'Remembrance, Advent & Christmas',
    feasts: [
      'All Souls’ Requiem',
      'A Festival of Nine Lessons & Carols',
      'Midnight Mass',
      'Christmas Day',
    ],
  },
];
---
<Base
  title="Special Services"
  description="The great feasts and special services of the Church's year at St Barnabas, Ealing — from Ash Wednesday and Holy Week to Nine Lessons & Carols and Midnight Mass."
  jsonLd={eventLd}
>
  <PageHeader
    kicker="Worship"
    title="Special Services"
    intro="We celebrate the Christian year in its fullness. These are some of the services we keep through the year."
  />
  <div class="wrap page-body">
    {upcoming.length > 0 && (
      <section class="upcoming" aria-labelledby="upcoming-heading">
        <div class="upcoming__head">
          <h2 class="label upcoming__label" id="upcoming-heading">Coming up</h2>
          <a class="txt-link" href="/whats-on">Everything that's on</a>
        </div>
        <EventsList events={upcoming} />
      </section>
    )}

    <div class="feast-groups">
      {groups.map((group) => (
        <section class="feast-group">
          <h2 class="label feast-group__title">{group.title}</h2>
          <ul class="feast-list">
            {group.feasts.map((f) => <li class="feast-list__item serif">{f}</li>)}
          </ul>
        </section>
      ))}
    </div>
    <p class="page-aside">
      Dates and times for these and everything else in the parish are on
      <a href="/whats-on">What's On</a>, announced in our <a href="/news">weekly newsletter</a>,
      and posted on the noticeboards along the Lane. To be kept in touch, do
      <a href="/contact-us">join the mailing list</a>.
    </p>
  </div>
</Base>

<style>
  .upcoming { margin-bottom: 3.4rem; }
  .upcoming__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }
  .upcoming__label { color: var(--violet); display: block; }
  .feast-groups { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 3.5rem; }
  .feast-group__title { color: var(--violet); margin-bottom: 1.2rem; }
  .feast-list { list-style: none; display: grid; gap: .9rem; }
  .feast-list__item {
    font-size: 1.4rem;
    font-weight: 500;
    border-top: 1px solid var(--line);
    padding-top: .9rem;
  }
  @media (max-width: 640px) {
    .feast-groups { grid-template-columns: 1fr; gap: 2.2rem; }
  }
</style>
