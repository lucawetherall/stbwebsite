---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Figure from '../components/Figure.astro';
import { site } from '../data/site';
---
<Base
  title="Music"
  description="Music at St Barnabas, Ealing — a thriving choir in the Anglican choral tradition leading the Sung Mass each Sunday, with paid choral scholarships and young singers welcome."
  image="/images/music/choir-organ.webp"
>
  <PageHeader
    title="Music"
    intro="Music is woven through everything we do — and it carries the prayer of this place."
  />
  <div class="wrap page-body music-page">
    <Figure
      src="/images/music/choir-organ.webp"
      alt="The choir and organ at St Barnabas"
      caption="The choir and organ at St Barnabas"
      aspect="16 / 9"
      eager
    />
    <div class="prose">
      <p>
        We are fortunate to have a well-established and thriving choir, rooted in the Anglican
        choral tradition, that leads our musical offering and helps us encounter God in our
        common worship. The choir sings the <strong>Sung Mass every Sunday at 10.30am</strong> —
        a sung setting, hymns, a sung psalm and a
        communion anthem — and also sings Choral Evensong and the great festivals of the year.
      </p>
    </div>

    <p class="page-aside">
      Our choir is led by our Director of Music (Luca) and our Organist (Hugh), with paid
      choral scholars and a body of voluntary singers. <a href="/music/our-musicians">Meet our musicians →</a>
    </p>

    <section class="music-section">
      <h2 class="label music-section__label">Listen</h2>
      <div class="prose">
        <p>
          Many of our services are livestreamed and archived on our
          <a href={site.social.youtube} target="_blank" rel="noopener">YouTube channel</a>, where
          you can hear the choir and organ. You are always welcome to come and listen in person.
        </p>
      </div>
    </section>

  </div>
</Base>

<style>
  .music-section { margin-top: 2.8rem; }
  .music-section__label { color: var(--burgundy); display: block; margin-bottom: 1rem; }
</style>
