# Long-cache immutable, content-stable assets
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable
# …except the CMS-managed folders: editors replace these files in place under the
# same name (a new portrait, a corrected upload), so a year-long pin would show a
# stale image indefinitely. Later matching rules override the same header above.
/images/uploads/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/images/staff/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind's search index. The chunks carry a content hash in the filename, so they are safe to
# cache forever; pagefind-entry.json (which names the current chunks) is deliberately left to the
# default so a rebuilt index is picked up on the next visit.
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/filter/*
  Cache-Control: public, max-age=31536000, immutable

# Documents may be updated in place — cache for a day
/documents/*
  Cache-Control: public, max-age=86400

# The subscribable parish calendar. The site sends X-Content-Type-Options: nosniff below, so the
# Content-Type has to be right or calendar apps will refuse the file.
/calendar.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600

# Security headers on every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
